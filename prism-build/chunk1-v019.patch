--- PrismWidget/app/src/main/java/com/oddfox/prism/PrismBindingTarget.kt
+++ PrismWidget/app/src/main/java/com/oddfox/prism/PrismBindingTarget.kt
@@ -0,0 +1,37 @@
+package com.oddfox.prism
+
+/** The destination of a value edit is immutable while the picker is open.
+ * A layer formula can never silently become a root/background formula. */
+data class PrismBindingTarget(
+    val property: String,
+    val layerId: String? = null
+) {
+    val isRoot: Boolean get() = layerId == null
+
+    init {
+        require(property in (if (isRoot) PrismPropertyBindings.designKeys else PrismPropertyBindings.keys)) {
+            "Unsupported formula target: $property"
+        }
+        require(layerId == null || layerId.isNotBlank()) { "A layer target needs a stable layer ID" }
+    }
+
+    fun belongsTo(design: WidgetDesign): Boolean =
+        isRoot || design.layers.any { it.id == layerId }
+
+    fun formula(design: WidgetDesign): String? =
+        if (isRoot) design.propertyFormulas[property]
+        else design.layers.firstOrNull { it.id == layerId }?.propertyFormulas?.get(property)
+
+    /** Apply only to the originally selected layer; if it was deleted, do nothing. */
+    fun apply(design: WidgetDesign, value: String?): WidgetDesign {
+        if (!belongsTo(design)) return design
+        val updated = if (value.isNullOrBlank()) null else value.trim().take(1024)
+        fun mapFormula(previous: Map<String, String>): Map<String, String> =
+            if (updated == null) previous - property else previous + (property to updated)
+        if (isRoot) return design.copy(propertyFormulas = mapFormula(design.propertyFormulas),
+            background = if (property == "backgroundImageAsset" && updated != null) "IMAGE" else design.background)
+        return design.copy(layers = design.layers.map { layer ->
+            if (layer.id == layerId) layer.copy(propertyFormulas = mapFormula(layer.propertyFormulas)) else layer
+        })
+    }
+}
