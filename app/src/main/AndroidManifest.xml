<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.software.live_wallpaper" android:required="false"/>
    <uses-feature android:name="android.hardware.location" android:required="false"/>
    <!-- Only used when browsing or downloading user-selected online 4K images. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- Optional and requested only for the clock or widget home-screen edit overlay. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@drawable/ic_halyn"
        android:label="${appTitle}"
        android:theme="@style/Theme.HalynMotion"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true">
        <!-- ML Kit's optional on-device subject model; prefetch when supported. -->
        <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="subject_segment"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service
            android:name=".ClockPlacementService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-requested short-lived draggable clock placement grid on the launcher; stops on X or notification Exit."/>
        </service>
        <service
            android:name=".HomeWidgetEditorService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-initiated temporary home-screen overlay to add, reposition, resize, rotate and recolour HALYN wallpaper elements; ends on Done or notification Exit."/>
        </service>
        <service
            android:name=".HalynNotificationListener"
            android:enabled="true"
            android:exported="true"
            android:label="HALYN notification pulses"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>
        <service
            android:name=".HalynWallpaperService"
            android:enabled="true"
            android:exported="true"
            android:label="${wallpaperTitle}"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService"/>
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/halyn_wallpaper"/>
        </service>
    </application>
</manifest>
